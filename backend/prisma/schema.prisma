generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Usuario {
  id     Int     @id @default(autoincrement())
  nome   String
  email  String  @unique
  senha  String
  tipo   String

  provas Prova[]
}

model Prova {
  id        Int      @id @default(autoincrement())
  nome      String
  tipo      String
  data      DateTime @default(now())

  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
}

model Questao {
  id          Int    @id @default(autoincrement())
  enunciado   String
  alternativaA String
  alternativaB String
  alternativaC String
  alternativaD String
  correta     String
}